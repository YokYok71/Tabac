# Force `npm install` to enumerate every platform's optional deps in
# package-lock.json so that `npm ci` on a different platform (Linux/
# macOS/Windows CI runners) doesn't bail with EUSAGE "Missing X from
# lock file". Required since the Vite 8 / Rolldown migration (build
# 22) — Vite 8 pulls in lightningcss + @oxc-parser + @oxc-resolver +
# rolldown which each declare ~15 platform-specific bindings under
# optionalDependencies. Without this flag, `npm install` on Linux
# only writes the linux-x64-gnu binding to the lock, and CI breaks
# the moment it sees a `Missing: lightningcss-android-arm64@x.y.z
# from lock file` line for any of the other platforms.
include=optional
